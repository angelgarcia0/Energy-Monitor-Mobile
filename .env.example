# Origen del backend (sin /api/v1). Ejemplos:
#   web / simulador de iOS : http://localhost:8080
#   emulador de Android     : http://10.0.2.2:8080
#   teléfono físico         : http://192.168.1.50:8080  (IP del PC en la misma red)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Identificador del proyecto de Expo (expo.dev → proyecto → Project settings, o
# `eas init`). Sin él `expo-notifications` no puede pedir un token de push y el
# registro del teléfono queda desactivado. No es un secreto: va dentro del APK.
#
# OJO: esto NO es el "Access token" de push. Ese lo usa el backend
# (EXPO_ACCESS_TOKEN en su .env) y nunca debe escribirse aquí: todo lo
# EXPO_PUBLIC_* acaba dentro del APK, donde cualquiera que lo descargue lo lee.
EXPO_PUBLIC_EAS_PROJECT_ID=98821905-8663-4d75-b8f4-684a26cf80cf

# Inicio de sesión con Google: el ID del cliente OAuth de tipo **Web** (el mismo
# GOOGLE_CLIENT_ID del servicio de seguridad), no el de Android. El cliente Android
# (paquete com.energymonitor.mobile + SHA-1 de la llave que firma la APK) debe
# existir en el mismo proyecto de Google Cloud. No es un secreto. Vacío = el
# botón de Google muestra que no está disponible.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=